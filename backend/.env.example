# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Required ---
# OpenRouter key used for all agent LLM calls (Claude + GPT models)
OPENROUTER_API_KEY=sk-or-v1-...
# Supabase project URL and SERVICE ROLE key (not the anon key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- AI proxy for student code (optional; /api/proxy returns 503 if unset) ---
GEMINI_API_KEY=

# --- Server ---
# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Public URL of this backend, shown to students in generated curricula
BASE_URL=http://localhost:8000
CLIENT_PORT=8000
FLASK_DEBUG=0
